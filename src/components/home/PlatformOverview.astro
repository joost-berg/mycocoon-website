---
import Container from '../ui/Container.astro';

const features = [
    {
        title: 'Cliënt & dossier',
        text: 'Van aanmelding en intake tot zorgregistratie en een compleet dossier.',
        icon: 'user',
    },
    {
        title: 'Planning',
        text: 'Plan cliënten, medewerkers en capaciteit vanuit één overzicht.',
        icon: 'calendar',
    },
    {
        title: 'Zorgverlening',
        text: 'Snel registreren en rapporteren, ook onderweg.',
        icon: 'heart',
    },
    {
        title: 'Administratie & declaratie',
        text: 'Van tarieven en controles tot declaraties en financiële afhandeling.',
        icon: 'document',
    },
    {
        title: 'Inzicht & sturing',
        text: 'Dashboards en rapportages voor dagelijkse aansturing en beleid.',
        icon: 'chart',
    },
    {
        title: 'Koppelingen',
        text: 'Wissel veilig informatie uit met andere systemen en zorgverleners.',
        icon: 'link',
    },
];
---

<section id="platform" class="bg-white py-20 sm:py-24 lg:py-28">
    <Container>
        <div class="mx-auto max-w-3xl text-center">
            <span class="text-sm font-semibold uppercase tracking-[0.14em] text-brand-600">
                Het platform
            </span>

            <h2 class="mt-4 font-heading text-3xl font-bold tracking-[-0.035em] text-navy-950 sm:text-4xl lg:text-5xl">
                Eén platform voor het hele kraamzorgproces
            </h2>

            <p class="mt-5 text-lg leading-8 text-navy-600">
                Geen verzameling losse systemen, maar één doorlopend proces. Van de eerste
                aanmelding tot de laatste declaratie.
            </p>
        </div>

        <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {features.map((feature) => (
                <article class="group rounded-2xl border border-navy-100 bg-white p-7 transition duration-200 hover:-translate-y-1 hover:border-brand-200 hover:shadow-lg">
                    <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-brand-50 text-brand-600">
                        {feature.icon === 'user' && (
                            <svg
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                class="h-6 w-6"
                            >
                                <path
                                    stroke-width="1.8"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM22 21v-2a4 4 0 0 0-3-3.87"
                                />
                            </svg>
                        )}

                        {feature.icon === 'calendar' && (
                            <svg
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                class="h-6 w-6"
                            >
                                <path
                                    stroke-width="1.8"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M3 5h18v16H3zM7 3v4M17 3v4M3 9h18"
                                />
                            </svg>
                        )}

                        {feature.icon === 'heart' && (
                            <svg
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                class="h-6 w-6"
                            >
                                <path
                                    stroke-width="1.8"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8Z"
                                />
                            </svg>
                        )}

                        {feature.icon === 'document' && (
                            <svg
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                class="h-6 w-6"
                            >
                                <path
                                    stroke-width="1.8"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M6 2h9l5 5v15H6zM14 2v6h6M9 13h6M9 17h6"
                                />
                            </svg>
                        )}

                        {feature.icon === 'chart' && (
                            <svg
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                class="h-6 w-6"
                            >
                                <path
                                    stroke-width="1.8"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M4 20V10M10 20V4M16 20v-7M22 20V7"
                                />
                            </svg>
                        )}

                        {feature.icon === 'link' && (
                            <svg
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                class="h-6 w-6"
                            >
                                <path
                                    stroke-width="1.8"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M10 13a5 5 0 0 0 7.1 0l2.8-2.8a5 5 0 0 0-7.1-7.1L11.2 4.7M14 11a5 5 0 0 0-7.1 0l-2.8 2.8a5 5 0 0 0 7.1 7.1l1.6-1.6"
                                />
                            </svg>
                        )}
                    </div>

                    <h3 class="mt-5 font-heading text-xl font-bold tracking-[-0.02em] text-navy-900">
                        {feature.title}
                    </h3>

                    <p class="mt-3 leading-7 text-navy-600">{feature.text}</p>
                </article>
            ))}
        </div>
    </Container>
</section>
