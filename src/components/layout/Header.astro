---
import { withBase } from '../../utils/withBase';
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';

const navigation = [
    { label: 'Platform', href: '#platform' },
    { label: 'Voor wie', href: '#voor-wie' },
    { label: 'Koppelingen', href: '#koppelingen' },
    { label: 'Veiligheid', href: '#veiligheid' },
    { label: 'Over MyCocoon', href: '#over' },
];
---

<header class="border-b border-navy-100 bg-white/95 backdrop-blur">
    <Container class="flex h-20 items-center justify-between">
        <a
            href={withBase('/')}
            class="font-heading text-xl font-bold tracking-[-0.03em] text-navy-900"
            aria-label="MyCocoon home"
        >
            <img
                src="/images/header/logo.png"
                alt="logo"
                class="w-75"
                loading="eager"
                fetchpriority="high"
            />
        </a>

        <nav class="hidden items-center gap-8 lg:flex" aria-label="Hoofdnavigatie">
            {navigation.map((item) => (
                <a
                    href={item.href}
                    class="text-sm font-medium text-navy-600 transition hover:text-navy-900"
                >
                    {item.label}
                </a>
            ))}
        </nav>

        <div class="hidden lg:block">
            <Button href="#demo">Plan een demo</Button>
        </div>

        <button
            id="mobile-menu-toggle"
            type="button"
            class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-navy-200 text-navy-900 lg:hidden"
            aria-label="Menu openen"
            aria-expanded="false"
            aria-controls="mobile-menu"
        >
            <span class="sr-only">Menu openen</span>

            <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                class="h-5 w-5"
                aria-hidden="true"
            >
                <path d="M4 7h16M4 12h16M4 17h16" />
            </svg>
        </button>
    </Container>

    <div id="mobile-menu" class="hidden border-t border-navy-100 bg-white lg:hidden">
        <Container class="py-6">
            <nav class="flex flex-col gap-4" aria-label="Mobiele navigatie">
                {navigation.map((item) => (
                    <a href={item.href} class="text-base font-medium text-navy-700">
                        {item.label}
                    </a>
                ))}

                <div class="pt-2">
                    <Button href="#demo" class="w-full">
                        Plan een demo
                    </Button>
                </div>
            </nav>
        </Container>
    </div>
</header>

<script>
    const toggle = document.querySelector('#mobile-menu-toggle');
    const menu = document.querySelector('#mobile-menu');

    toggle?.addEventListener('click', () => {
        const isOpen = toggle.getAttribute('aria-expanded') === 'true';

        toggle.setAttribute('aria-expanded', String(!isOpen));
        menu?.classList.toggle('hidden');
    });
</script>
