---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Button from '../components/ui/Button.astro';
---

<BaseLayout title="Contact | MyCocoon">
    <section class="bg-navy-50 py-16 sm:py-20 lg:py-28">
        <Container>
            <div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:items-start">
                <div class="lg:sticky lg:top-28">
                    <span class="text-sm font-semibold uppercase tracking-[0.14em] text-brand-600">
                        Kennismaken
                    </span>

                    <h1 class="mt-4 font-heading text-4xl font-bold tracking-[-0.04em] text-navy-950 sm:text-5xl lg:text-6xl">
                        Ontdek wat MyCocoon voor jullie organisatie kan betekenen.
                    </h1>

                    <p class="mt-6 max-w-xl text-lg leading-8 text-navy-600">
                        Laat je gegevens achter en we nemen contact met je op om samen te kijken
                        waar MyCocoon kan helpen. We laten het platform graag zien aan de hand van
                        jullie eigen werkprocessen.
                    </p>

                    <div class="mt-8 rounded-2xl border border-brand-100 bg-white p-6">
                        <p class="font-heading text-lg font-bold text-navy-900">
                            Liever direct contact?
                        </p>

                        <a
                            href="mailto:info@mycocoon.nl"
                            class="mt-3 inline-flex text-brand-700 underline decoration-brand-200 underline-offset-4 hover:text-brand-900"
                        >
                            info@mycocoon.nl
                        </a>
                    </div>
                </div>

                <div class="rounded-3xl bg-white p-6 shadow-sm ring-1 ring-navy-100 sm:p-10">
                    <div class="mb-8">
                        <h2 class="font-heading text-2xl font-bold text-navy-950 sm:text-3xl">
                            Neem contact op
                        </h2>

                        <p class="mt-3 leading-7 text-navy-600">
                            De velden met een * zijn verplicht.
                        </p>
                    </div>

                    <form
                        action="mailto:info@mycocoon.nl"
                        method="post"
                        enctype="text/plain"
                        class="grid gap-6"
                    >
                        <div class="grid gap-6 sm:grid-cols-2">
                            <div>
                                <label
                                    for="email"
                                    class="text-sm font-semibold text-navy-900"
                                >
                                    E-mailadres *
                                </label>
                                <input
                                    id="email"
                                    name="email"
                                    type="email"
                                    required
                                    autocomplete="email"
                                    placeholder="jouwnaam@organisatie.nl"
                                    class="mt-2 block w-full rounded-xl border border-navy-200 bg-white px-4 py-3 text-navy-900 outline-none transition placeholder:text-navy-400 focus:border-brand-500 focus:ring-4 focus:ring-brand-100"
                                />
                            </div>

                            <div>
                                <label
                                    for="phone"
                                    class="text-sm font-semibold text-navy-900"
                                >
                                    Telefoonnummer
                                </label>
                                <input
                                    id="phone"
                                    name="phone"
                                    type="tel"
                                    autocomplete="tel"
                                    placeholder="06 12 34 56 78"
                                    class="mt-2 block w-full rounded-xl border border-navy-200 bg-white px-4 py-3 text-navy-900 outline-none transition placeholder:text-navy-400 focus:border-brand-500 focus:ring-4 focus:ring-brand-100"
                                />
                            </div>
                        </div>

                        <div>
                            <label for="company" class="text-sm font-semibold text-navy-900">
                                Bedrijfsnaam
                            </label>
                            <input
                                id="company"
                                name="company"
                                type="text"
                                autocomplete="organization"
                                placeholder="Naam van je organisatie"
                                class="mt-2 block w-full rounded-xl border border-navy-200 bg-white px-4 py-3 text-navy-900 outline-none transition placeholder:text-navy-400 focus:border-brand-500 focus:ring-4 focus:ring-brand-100"
                            />
                        </div>

                        <div>
                            <label for="message" class="text-sm font-semibold text-navy-900">
                                Waar kunnen we je mee helpen?
                            </label>
                            <textarea
                                id="message"
                                name="message"
                                rows="6"
                                placeholder="Vertel kort waar je benieuwd naar bent of welke uitdaging jullie ervaren."
                                class="mt-2 block w-full resize-y rounded-xl border border-navy-200 bg-white px-4 py-3 text-navy-900 outline-none transition placeholder:text-navy-400 focus:border-brand-500 focus:ring-4 focus:ring-brand-100"
                            ></textarea>
                        </div>

                        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
                            <p class="max-w-md text-sm leading-6 text-navy-500">
                                We gebruiken je gegevens alleen om contact met je op te nemen naar
                                aanleiding van je bericht.
                            </p>

                            <Button>Verstuur aanvraag</Button>
                        </div>
                    </form>
                </div>
            </div>
        </Container>
    </section>
</BaseLayout>
