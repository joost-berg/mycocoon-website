---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

interface Props {
    title: string;
}

const { title } = Astro.props;

// Only the GitHub Pages preview disables indexing.
// Production builds must leave GITHUB_PAGES unset; verify robots tags at launch.
const isPreview = process.env.GITHUB_PAGES === 'true';
---

<!doctype html>
<html lang="nl">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />

        <title>{title}</title>

        {isPreview && <meta name="robots" content="noindex, nofollow" />}

        <meta
            name="description"
            content="MyCocoon is het complete softwareplatform voor kraamzorgorganisaties."
        />
    </head>

    <body>
        <Header />
        <main>
            <slot />
        </main>
        <Footer />
    </body>
</html>
